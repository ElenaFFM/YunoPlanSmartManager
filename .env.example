APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
YUNO_ENV=sandbox
WORKER_ID=local-worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_DURATION_MS=30000

# Solo necesarias para correr `npm run test:contract:yuno` (manual, ver docs/planning/10_TEST_STRATEGY.md §7).
# Usar SIEMPRE credenciales sandbox, nunca las de producción.
YUNO_SANDBOX_BASE_URL=https://api-sandbox.y.uno/v1
YUNO_PUBLIC_API_KEY=
YUNO_PRIVATE_SECRET_KEY=
YUNO_CONTRACT_TEST_ACCOUNT_ID=

# Laboratorio SDK: sesi\u00f3n de checkout sandbox creada exclusivamente desde el BFF.
GANDALF_CHECKOUT_SESSION_URL=
