{
  "name": "yuno-plan-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/main.ts",
    "worker:dev": "node --env-file-if-exists=.env --import tsx --watch src/worker/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test src/modules/catalog/domain/iin.test.ts src/modules/catalog/domain/template-configuration.test.ts src/modules/planning/domain/amount.test.ts src/modules/planning/domain/installments.test.ts src/modules/planning/domain/timeline.test.ts src/modules/planning/domain/canonical-hash.test.ts src/modules/planning/domain/effective-configuration.test.ts src/modules/planning/domain/installment-diff.test.ts src/modules/planning/domain/catalog-validation.test.ts src/modules/planning/domain/validation.test.ts src/modules/planning/domain/campaign.test.ts src/modules/planning/domain/sdk-case-generation.test.ts src/modules/planning/application/campaign-snapshot.test.ts src/modules/planning/application/template-snapshot.test.ts src/modules/executions/domain/lease-policy.test.ts src/modules/executions/domain/execution-plan.test.ts src/modules/executions/domain/execution-compensation.test.ts src/modules/executions/domain/remote-plan-logical-key.test.ts src/modules/executions/application/remote-plan-snapshot.test.ts src/modules/executions/application/remote-plan-known-ids.test.ts src/modules/executions/application/remote-plan-verification.test.ts src/modules/sdk-lab/domain/checkout-session.test.ts src/modules/sdk-lab/infrastructure/gandalf-checkout-client.test.ts src/infrastructure/config/env.test.ts",
    "test:watch": "node --experimental-strip-types --experimental-test-isolation=none --test --watch src/modules/catalog/domain/iin.test.ts src/modules/catalog/domain/template-configuration.test.ts src/modules/planning/domain/amount.test.ts src/modules/planning/domain/installments.test.ts src/modules/planning/domain/timeline.test.ts src/modules/planning/domain/canonical-hash.test.ts src/modules/planning/domain/effective-configuration.test.ts src/modules/planning/domain/installment-diff.test.ts src/modules/planning/domain/catalog-validation.test.ts src/modules/planning/domain/validation.test.ts src/modules/planning/domain/campaign.test.ts src/modules/planning/domain/sdk-case-generation.test.ts src/modules/planning/application/campaign-snapshot.test.ts src/modules/planning/application/template-snapshot.test.ts src/modules/executions/domain/lease-policy.test.ts src/modules/executions/domain/execution-plan.test.ts src/modules/executions/domain/execution-compensation.test.ts src/modules/executions/application/remote-plan-snapshot.test.ts src/modules/executions/application/remote-plan-known-ids.test.ts src/infrastructure/config/env.test.ts",
    "test:integration:catalog": "node --env-file=.env --import tsx src/modules/catalog/infrastructure/catalog.integration.ts",
    "test:integration:queue": "node --env-file=.env --import tsx src/modules/executions/infrastructure/execution-run-queue.integration.ts",
    "test:integration:execution-worker": "node --env-file=.env --import tsx src/modules/executions/application/execution-worker.integration.ts",
    "test:integration:campaign": "node --env-file=.env --import tsx src/modules/planning/infrastructure/campaign.integration.ts",
    "test:integration:campaign-deployment-plan": "node --env-file=.env --import tsx src/modules/executions/application/campaign-deployment-plan.integration.ts",
    "test:integration:scope-catalog": "node --env-file=.env --import tsx src/modules/planning/infrastructure/scope-catalog.integration.ts",
    "test:contract:yuno": "node --env-file=.env --import tsx src/modules/executions/infrastructure/yuno-installments.contract.ts",
    "test:contract:execution-worker": "node --env-file=.env --import tsx src/modules/executions/application/execution-worker.contract.ts",
    "prisma:generate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js generate",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:migrate:dev": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@yuno-payments/sdk-web": "^8.0.1",
    "next": "16.3.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prisma": "7.9.1",
    "tsx": "4.23.8",
    "typescript": "6.0.3"
  }
}
