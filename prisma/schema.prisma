generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VIEWER
  OPERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum IinStatus {
  ACTIVE
  INACTIVE
}

enum TemplateScope {
  GENERAL
  BANK
  AMEX
}

enum CampaignVersionStatus {
  DRAFT
  VALIDATED
  SUPERSEDED
}

enum Environment {
  SANDBOX
  PRODUCTION
}

enum DeploymentKind {
  CANONICAL
  TEST
}

enum DeploymentStatus {
  PLANNED
  READY
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RECONCILIATION_REQUIRED
  CANCELLED
}

enum ExecutionRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  ROLLED_BACK
  RECONCILIATION_REQUIRED
  CANCELLED
}

enum OperationType {
  CREATE
  UPDATE
  DELETE
  VERIFY
  COMPENSATE_CREATE
  COMPENSATE_UPDATE
  COMPENSATE_DELETE
}

enum OperationStatus {
  PENDING
  SENT
  SUCCEEDED
  FAILED
  UNKNOWN
  SKIPPED
}

enum ResultCertainty {
  CONFIRMED
  FAILED
  UNKNOWN
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  displayName String
  role        UserRole   @default(VIEWER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  campaignsCreated Campaign[]        @relation("CampaignCreatedBy")
  versionsCreated  CampaignVersion[] @relation("VersionCreatedBy")
  deployments      Deployment[]      @relation("DeploymentCreatedBy")
  runsRequested    ExecutionRun[]    @relation("RunRequestedBy")
  approvals        Approval[]        @relation("ApprovalDecidedBy")
  templateVersions TemplateVersion[] @relation("TemplateVersionCreatedBy")
}

model Bank {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String        @unique
  description String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  iins             BankIin[]
  templateVersions TemplateVersion[]
  testCards        TestCard[]

  @@index([status, name])
}

model BankIin {
  id         String    @id @default(cuid())
  bankId     String
  value      String
  status     IinStatus @default(ACTIVE)
  activeFrom DateTime  @default(now())
  activeTo   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  bank Bank @relation(fields: [bankId], references: [id])

  @@index([bankId, status])
  @@index([value, status])
}

model TestCard {
  id         String   @id @default(cuid())
  bankId     String?
  label      String
  cardNumber String
  iin        String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bank Bank? @relation(fields: [bankId], references: [id])

  @@index([bankId, active])
}

model PromotionTemplate {
  id               String        @id @default(cuid())
  name             String        @unique
  description      String?
  scope            TemplateScope
  status           CatalogStatus @default(ACTIVE)
  currentVersionId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  currentVersion TemplateVersion?  @relation("CurrentTemplateVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       TemplateVersion[] @relation("TemplateVersions")

  @@index([status, name])
}

model TemplateVersion {
  id                    String   @id @default(cuid())
  templateId            String
  versionNumber         Int
  canonicalHash         String
  configurationSnapshot Json
  bankId                String?
  changeReason          String
  createdById           String
  createdAt             DateTime @default(now())

  template           PromotionTemplate  @relation("TemplateVersions", fields: [templateId], references: [id])
  currentForTemplate PromotionTemplate? @relation("CurrentTemplateVersion")
  bank               Bank?              @relation(fields: [bankId], references: [id])
  createdBy          User               @relation("TemplateVersionCreatedBy", fields: [createdById], references: [id])
  campaignVersions   CampaignVersion[]

  @@unique([templateId, versionNumber])
  @@index([bankId, createdAt])
}

model Campaign {
  id               String   @id @default(cuid())
  name             String
  description      String?
  createdById      String
  currentVersionId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy      User              @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  currentVersion CampaignVersion?  @relation("CurrentCampaignVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       CampaignVersion[] @relation("CampaignVersions")
}

model CampaignVersion {
  id                      String                @id @default(cuid())
  campaignId              String
  versionNumber           Int
  status                  CampaignVersionStatus @default(DRAFT)
  canonicalHash           String
  changeReason            String
  configurationSnapshot   Json
  createdById             String
  createdAt               DateTime              @default(now())
  supersededAt            DateTime?
  sourceTemplateVersionId String?

  campaign              Campaign         @relation("CampaignVersions", fields: [campaignId], references: [id])
  currentForCampaign    Campaign?        @relation("CurrentCampaignVersion")
  createdBy             User             @relation("VersionCreatedBy", fields: [createdById], references: [id])
  deployments           Deployment[]
  approvals             Approval[]
  sourceTemplateVersion TemplateVersion? @relation(fields: [sourceTemplateVersionId], references: [id])

  @@unique([campaignId, versionNumber])
  @@index([status, createdAt])
}

model Deployment {
  id                String           @id @default(cuid())
  campaignVersionId String
  environment       Environment
  kind              DeploymentKind
  status            DeploymentStatus @default(PLANNED)
  configurationHash String
  baseSnapshotHash  String
  scheduledAt       DateTime?
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  campaignVersion CampaignVersion @relation(fields: [campaignVersionId], references: [id])
  createdBy       User            @relation("DeploymentCreatedBy", fields: [createdById], references: [id])
  runs            ExecutionRun[]

  @@index([environment, status, scheduledAt])
}

model ExecutionRun {
  id                     String             @id @default(cuid())
  deploymentId           String
  status                 ExecutionRunStatus @default(QUEUED)
  idempotencyKey         String             @unique
  planHash               String
  baseSnapshotHash       String
  approvedPlanHash       String?
  lockKey                String
  queuedAt               DateTime           @default(now())
  claimedAt              DateTime?
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  nextAttemptAt          DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  heartbeatAt            DateTime?
  requestedById          String
  failureClassification  String?
  lastConfirmedOperation Int                @default(0)

  deployment  Deployment           @relation(fields: [deploymentId], references: [id])
  requestedBy User                 @relation("RunRequestedBy", fields: [requestedById], references: [id])
  operations  ExecutionOperation[]
  approvals   Approval[]

  @@index([status, nextAttemptAt, queuedAt])
  @@index([lockKey, status])
}

model ExecutionOperation {
  id                      String           @id @default(cuid())
  runId                   String
  sequence                Int
  type                    OperationType
  status                  OperationStatus  @default(PENDING)
  targetRemotePlanId      String?
  requestSnapshot         Json?
  responseSnapshot        Json?
  expectedResultSnapshot  Json?
  compensationSnapshot    Json?
  attemptCount            Int              @default(0)
  startedAt               DateTime?
  sentAt                  DateTime?
  finishedAt              DateTime?
  errorCode               String?
  errorMessage            String?
  resultCertainty         ResultCertainty?
  compensationOperationId String?

  run                   ExecutionRun         @relation(fields: [runId], references: [id])
  compensationOperation ExecutionOperation?  @relation("OperationCompensation", fields: [compensationOperationId], references: [id])
  compensates           ExecutionOperation[] @relation("OperationCompensation")

  @@unique([runId, sequence])
  @@index([runId, status])
}

model Approval {
  id                String    @id @default(cuid())
  campaignVersionId String
  executionRunId    String
  planHash          String
  decision          String
  checklistSnapshot Json
  warningsAccepted  Json?
  decidedById       String
  decidedAt         DateTime  @default(now())
  revokedAt         DateTime?
  revocationReason  String?

  campaignVersion CampaignVersion @relation(fields: [campaignVersionId], references: [id])
  executionRun    ExecutionRun    @relation(fields: [executionRunId], references: [id])
  decidedBy       User            @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([executionRunId, planHash, revokedAt])
}
